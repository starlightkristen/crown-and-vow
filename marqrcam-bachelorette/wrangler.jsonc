{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marqrcam-crown-vow-bach-2026",
  "main": "src/index.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PROJECT_NAMESPACE": "marqrcam-crown-vow-bach-2026",
    "EVENT_SLUG": "crown-vow-bachelorette-2026-09-18"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/manifest.webmanifest"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marqrcam-crown-vow-bach-2026-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./migrations",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "marqrcam-crown-vow-bach-2026-photos",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
